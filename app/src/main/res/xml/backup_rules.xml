<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Device identity and activation must not migrate to another device. -->
    <exclude domain="sharedpref" path="device_lock_prefs.xml" />
    <exclude domain="sharedpref" path="mosarib_license_prefs.xml" />
    <!-- Do not duplicate manually exported, unencrypted backups in OS cloud backup. -->
    <exclude domain="file" path="backups/" />
</full-backup-content>
