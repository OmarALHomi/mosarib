<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="device_lock_prefs.xml" />
        <exclude domain="sharedpref" path="mosarib_license_prefs.xml" />
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device_lock_prefs.xml" />
        <exclude domain="sharedpref" path="mosarib_license_prefs.xml" />
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
