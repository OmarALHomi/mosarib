# Hostinger & LiteSpeed / Apache 2.4 Configuration
RewriteEngine On

# Pass Authorization header to PHP in FastCGI / FPM environments
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Protect sensitive files (Compatible with Apache 2.4 and LiteSpeed)
<FilesMatch "(config\.json|service_account\.json|\.env|\.git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow APK downloads with proper MIME type
AddType application/vnd.android.package-archive .apk

# Set directory index
DirectoryIndex index.php index.html
